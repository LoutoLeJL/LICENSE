{
  "name": "geoguessr-clone-server",
  "version": "1.0.0",
  "description": "Serveur Socket.io pour un clone multijoueur de GeoGuessr (gestion du lobby, des manches et des scores).",
  "main": "index.js",
  "bin": "host.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "host": "node host.js",
    "build:exe": "pkg . --output dist/GeoGuessrHost && node scripts/postbuild.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.2.0"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ]
  }
}
