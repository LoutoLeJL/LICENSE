# ----------------------------------------------------------------------------
# Configuration du SERVEUR (backend Socket.io)
# Copie ce fichier en `.env` puis adapte les valeurs.  Ne committe JAMAIS `.env`.
# ----------------------------------------------------------------------------

# Port d'écoute du serveur. Render fournit automatiquement la variable PORT,
# tu n'as donc rien à changer pour Render.
PORT=3000

# Origine(s) autorisée(s) pour CORS / Socket.io.
# - En local ou en déploiement "tout-en-un" (le serveur sert aussi le front) :
#   laisse "*".
# - En déploiement SÉPARÉ (front sur Vercel/Netlify, back sur Render) : mets
#   l'URL exacte de ton frontend, ex: https://mon-geoguessr.vercel.app
#   (plusieurs origines possibles, séparées par des virgules).
CLIENT_ORIGIN=*

# ----------------------------------------------------------------------------
# ⚠️ La clé Google Maps n'est PAS ici : elle vit côté CLIENT (client/config.js)
# car l'API Street View s'exécute dans le navigateur. On la sécurise par des
# restrictions de domaine + quotas (voir le README, section "Sécuriser la clé").
# ----------------------------------------------------------------------------
